{
  "apiVersion": "heaven.app/v1",
  "kind": "Application",
  "metadata": {
    "name": "heaven-discord-bot",
    "displayName": "Heaven Discord Bot",
    "description": "Discord Gateway slash-command service on Heaven1 with independently verified updates and rollback."
  },
  "targets": [
    "server"
  ],
  "capabilities": [
    "core.logging",
    "network.http",
    "runtime.background-jobs",
    "release.autoupdate"
  ],
  "quality": {
    "accessibility": false,
    "offline": false,
    "visualRegression": false,
    "performanceBudget": true,
    "security": true
  }
}
